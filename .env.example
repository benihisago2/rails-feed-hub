# Copy this file to .env before the first `docker compose up`:
#
#   cp .env.example .env
#
# Inside Docker Compose the hostnames are the service names -- `db` and
# `redis`. They are never `localhost`, because each service is its own
# container. GitHub Actions is the opposite case: service containers publish to
# the runner, so there both hosts are `localhost`. Do not copy one into the
# other.

# --- Postgres container (consumed by the `db` service) ---
POSTGRES_USER=feedhub
POSTGRES_PASSWORD=feedhub
POSTGRES_DB=feedhub_development

# --- Rails ---
DATABASE_URL=postgres://feedhub:feedhub@db:5432/feedhub_development
TEST_DATABASE_URL=postgres://feedhub:feedhub@db:5432/feedhub_test
REDIS_URL=redis://redis:6379/0

# Puma thread count and the Active Record connection pool size.
RAILS_MAX_THREADS=5
