# Keep the build context small and free of host-specific state.
# Gemfile and Gemfile.lock must NOT be listed here: the image depends on them.

# Version control and editor state.
.git
.gitignore
.gitattributes
.github
.idea
.vscode

# Local environment files. Only the template belongs in the image.
.env
.env.*
!.env.example

# Runtime state generated on the host.
log/*
!log/.keep
tmp/*
!tmp/.keep
storage/*
!storage/.keep
public/assets
node_modules

# Test and analysis output.
coverage
spec/examples.txt
.rubocop_cache

# Docker files themselves.
Dockerfile
compose.yaml
.dockerignore

# OS noise.
.DS_Store
Thumbs.db
*.swp
*~
