<%= form_with model: feed do |form| %>
  <% if feed.errors.any? %>
    <div class="errors">
      <p><%= pluralize(feed.errors.count, "error") %> prevented this feed from being saved:</p>
      <ul>
        <% feed.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div class="field">
    <%= form.label :url, "Feed URL" %>
    <%= form.text_field :url, placeholder: "https://example.com/feed.xml" %>
  </div>

  <div class="field field-check">
    <%= form.check_box :active %>
    <%= form.label :active, "Fetch this feed on the schedule" %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "button" %>
    <%= link_to "Cancel", feeds_path %>
  </div>
<% end %>
