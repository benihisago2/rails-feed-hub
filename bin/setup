#!/usr/bin/env ruby
require "fileutils"

# One-command setup for a development environment. FeedHub runs inside Docker
# Compose, so this is meant to be run from within the `web` container (which
# already has Ruby and can reach the `db` / `redis` services):
#
#   docker compose run --rm web bin/setup
#
# It is idempotent -- run it as many times as you like. It installs gems,
# prepares the database and clears stale logs. It deliberately does NOT start a
# server: `docker compose up` owns the running processes.
APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Ready. Start the app with `docker compose up`. =="
end
